DATABASE_URL=postgres://user:pass@host:5432/gunes_mail
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=
# Same Google OAuth client the desktop app is built with (Desktop app type)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Azure app registration (public client) for Outlook.com / Microsoft 365; leave empty to disable
MICROSOFT_CLIENT_ID=
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:3000,http://localhost:3001,https://gunes-mail.denizlg24.com
SYNC_INTERVAL_SECONDS=45
INITIAL_SYNC_DAYS=90
# Email classifier service (apps/email-classifier); leave empty to disable categories
EMAIL_CLASSIFIER_URL=
EMAIL_CLASSIFIER_API_TOKEN=
CLASSIFY_DAYS=30
# Vercel AI Gateway; leave empty to disable summaries and drafting
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-haiku-5.5
