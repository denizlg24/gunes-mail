# Copy to .env.local and fill in. Values are compiled into the Tauri binary.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID → "Desktop app"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Azure app registration (public client, redirect http://localhost) for Microsoft accounts
MICROSOFT_CLIENT_ID=
# Mail server URL; defaults to https://gunes-mail.denizlg24.com
GUNES_MAIL_API_URL=http://localhost:3100
